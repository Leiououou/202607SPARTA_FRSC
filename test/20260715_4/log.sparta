SPARTA (24 Sep 2025)
Running on 4 MPI task(s)
################################################################################
# Molchanova LH3 体相(b)反应速率常数验证算例
# O(g) + C(b) --> CO(s)
# A=5.2e-20 b=0.5 Ea=5000K (非饱和, 无min(1,·)截断)
# 验证 Gamma_b = 1: 体相反应物不修正概率, P = 2K*n(S)/Vn (仅一个表面密度因子)
# T=700~2000K, 壁温=气体温度, tally_only (仅计数不反应)
# init_cover O 0.5 (50% 覆盖度, n(S)=3.011e18 恒定)
# 计算数据：nrho=4.138807e+20  lambda=3e-3 dt=1e-6 nsteps=5000
################################################################################

variable        T index 700 800 900 1000 1100 1200 1300 1400 1500 1600 1700 1800 1900 2000

label           loop

clear
Running on 4 MPI task(s)

seed    	    123456
dimension   	    2
global              gridcut 0.0 comm/sort yes

boundary	    	rs r p


create_box          -3e-3 3e-3 -3e-3 3e-3 -0.5 0.5
Created orthogonal box = (-0.003 -0.003 -0.5) to (0.003 0.003 0.5)
create_grid 	    10 10 1
WARNING: Could not acquire nearby ghost cells b/c grid partition is not clumped (../grid.cpp:473)
Created 100 child grid cells
  CPU time = 0.000882146 secs
  create/ghost percent = 68.1357 31.8643
balance_grid        rcb cell
Balance grid migrated 74 cells
  CPU time = 0.00131755 secs
  reassign/sort/migrate/ghost percent = 12.1249 0.0737731 66.4992 21.3021

global		    	nrho 4.138807e+20 fnum 1.4900e+11 temp ${T}
global		    	nrho 4.138807e+20 fnum 1.4900e+11 temp 700

species		    	air.species O CO CO2 O2 C N N2 NO
mixture		    	air O O2 N N2 vstream 0 0 0

mixture             air O   frac 1
mixture             air CO  frac 0.0
mixture             air CO2 frac 0.0
mixture             air C   frac 0.0
mixture 			air O2 	frac 0.0
mixture 			air N 	frac 0
mixture 			air N2 	frac 0.0
mixture 			air NO 	frac 0.0

create_particles    air n 0
Created 99998 particles
  CPU time = 0.00295839 secs

surf_collide        1 diffuse ${T} 1
surf_collide        1 diffuse 700 1

##################################### SURF REACT ADSORB ######################################
##################################### SURF OPTION ############################################

shell           awk -v T=${T} -f gen_td.awk schu_gs_1.surf > schu_gs_1_${T}.surf
shell           awk -v T=700 -f gen_td.awk schu_gs_1.surf > schu_gs_1_${T}.surf
shell           awk -v T=700 -f gen_td.awk schu_gs_1.surf > schu_gs_1_700.surf

surf_react        	adsorb_test_gs2 adsorb gs schu_gs_1_${T}.surf nsync 1 face ${T} 6.022e18 schu yes init_cover O 0.5 tally_only yes O CO N N2 O2 NO
surf_react        	adsorb_test_gs2 adsorb gs schu_gs_1_700.surf nsync 1 face ${T} 6.022e18 schu yes init_cover O 0.5 tally_only yes O CO N N2 O2 NO
surf_react        	adsorb_test_gs2 adsorb gs schu_gs_1_700.surf nsync 1 face 700 6.022e18 schu yes init_cover O 0.5 tally_only yes O CO N N2 O2 NO

bound_modify        xhi collide 1 react adsorb_test_gs2

timestep            1e-6

stats		    	10
stats_style	    	step cpu np nattempt ncoll nscoll nscheck nsreact
run 		    	5000
