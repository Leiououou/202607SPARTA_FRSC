################################################################################
# Molchanova 图4.c验证算例
#p=4 Pa T=700~100~2100K
#O+O(s)———> O2(s)
#只记数不发生
#计算数据：nrho=4.138807e+20  lambda=3e-3 t=5e-6
################################################################################

seed	    	    123456
dimension   	    2
global              gridcut 0.0 comm/sort yes

boundary	    	r r p


create_box          -3e-3 3e-3 -3e-3 3e-3 -0.5 0.5
create_grid 	    10 10 1
balance_grid        rcb cell

global		    	nrho 4.138807e+21 fnum 1.4900e+11 temp 1000
global              surfmax 5000
species		    	air.species O CO CO2 O2 C N N2 NO
mixture		    	air O O2 N N2 vstream 0 0 0

mixture             air O   frac 1
mixture             air CO  frac 0.0
mixture             air CO2 frac 0.0    
mixture             air C   frac 0.0
mixture 			air O2 	frac 0.0
mixture 			air N 	frac 0
mixture 			air N2 	frac 0.0
mixture 			air NO 	frac 0.0

read_surf           data.cylinder  scale 1e-3 1e-3 1 
surf_collide        1 diffuse 1000 1 #漫反射
surf_modify         all collide 1

create_particles    air n 0



##################################### SURF REACT ADSORB ######################################
##################################### SURF OPTION ############################################




surf_react        	adsorb_test_gs2 adsorb gs schu_gs_1.surf nsync 1 surf 1000 6.022e18 schu yes O CO N N2 O2 NO
surf_modify         all react adsorb_test_gs2
timestep            1e-6

compute         1 surf all all n nflux ke erot evib etot echem
fix 		    1 ave/surf all 1 100 100 c_1[*] ave running
dump		    1 surf all 100 surf.*.dat id v1x v1y v2x v2y  f_1[*]
dump_modify		1 format float %12.5g

stats		    	10
stats_style	    	step cpu np nattempt ncoll nscoll nscheck nsreact
run 		    	1000
