seed 24681357
dimension 2
boundary r r p

create_box -1 1 -1 1 -0.5 0.5
create_grid 4 4 1

global nrho 1000.0 fnum 1.0 temp 300.0 surfmax 100 surfs explicit/distributed
species ../20260727_ps_schu/air.species O O2
mixture air O O2
mixture air O frac 1.0
mixture air O2 frac 0.0

# Each coarse side spans multiple grid cells and may be collided with on
# more than one rank during the same timestep.
read_surf data.square

surf_collide wall diffuse 300.0 1.0
surf_react grxn gamma only_one yes gamma_oo.surf surf 300.0 O 1.0
surf_modify all collide wall react grxn

create_particles air n 20000
compute cnt count O O2

timestep 1.0e-3
stats 1
stats_style step time np nsreact c_cnt[1] c_cnt[2] sr_grxn[1] sr_grxn[2]
run 10

