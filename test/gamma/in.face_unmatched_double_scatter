seed 123456
dimension 3
boundary pp pp so

create_box 0 1 0 1 0 100
create_grid 1 1 1

global nrho 1.0 fnum 1.0
species ../20260727_ps_schu/air.species O O2
mixture air O O2

surf_collide wall diffuse 300.0 1.0
bound_modify zlo collide wall

surf_react grxn gamma gamma_oo.surf face 300.0 1.0 init_cover O2 1.0 O 1.0
bound_modify zlo react grxn

create_particles air single O 0.5 0.5 0.099 0.0 0.0 -100.0
dump p particle air 1 particle_unmatched.dat id type x y z vx vy vz

compute b boundary all n nflux ke erot evib etot echem
fix e ave/time 1 1 1 c_b[*] mode vector ave running file boundary_unmatched.dat

timestep 0.001
stats 1
stats_style step time np nsreact sr_grxn[1] sr_grxn[2] sr_grxn[3] sr_grxn[4]

# O impacts O2(s), but O+O2 is not in gamma_oo.surf:
# emit O and O2 separately, leave an empty site, and count no reaction.
run 1

# The empty-site check is deterministic: this O must adsorb.
# If O2(s) had not been removed above, it would instead emit another O2.
create_particles air single O 0.5 0.5 0.099 0.0 0.0 -100.0
run 1
