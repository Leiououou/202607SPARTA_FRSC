seed 123456
dimension 3
boundary oo oo so

create_box 0 1 0 1 0 1
create_grid 1 1 1

global nrho 1.0 fnum 1.0
species ../20260727_ps_schu/air.species O O2
mixture air O O2

surf_collide wall diffuse 300.0 1.0
bound_modify zlo collide wall

# Explicit gank no uses the unchanged nsite parser and state path.
surf_react grxn gamma gank no gamma_oo.surf face 300.0 1.0 O 1.0
bound_modify zlo react grxn

compute cnt count O O2
timestep 0.001
stats 1
stats_style step time np nsreact c_cnt[1] c_cnt[2] sr_grxn[1] sr_grxn[2]

create_particles air single O 0.5 0.5 0.099 0.0 0.0 -100.0
run 1
create_particles air single O 0.5 0.5 0.099 0.0 0.0 -100.0
run 1
