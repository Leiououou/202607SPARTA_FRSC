seed 123456
dimension 3
boundary oo oo so

create_box 0 1 0 1 0 1
create_grid 1 1 1

global nrho 1.0 fnum 1.0
species air.species O O2

surf_collide wall diffuse 300.0 1.0
bound_modify zlo collide wall

# max_cover=100, area=1, fnum=weight=1, initial O coverage=0.5:
# N_O=50, C(N_O,2)=1225.
# schu no:  nu = 1225*(1/100) = 12.25 1/s
# schu yes: nu = 1225*1       = 1225  1/s
surf_react psrxn adsorb ps ps_lh2.surf nsync 1 face 300.0 100.0 schu ${SCHU} init_cover O 0.5 O
bound_modify zlo react psrxn

timestep 0.001
stats 1000
stats_style step time np nsreact
run 10000
