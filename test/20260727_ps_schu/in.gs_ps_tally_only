seed 123456
dimension 3
boundary oo oo so

create_box 0 1 0 1 0 1
create_grid 1 1 1

global nrho 1.0 fnum 1.0
species air.species O O2

surf_collide wall diffuse 300.0 1.0
bound_modify zlo collide wall

# This parser/runtime check confirms that one tally_only value is accepted
# by a combined GS/PS model and reaches the PS event loop.  Existing GS
# tally-only behavior remains controlled by the same member flag.
surf_react both adsorb gs/ps gs_adsorb.surf ps_ds.surf nsync 1 face 300.0 100.0 schu yes init_cover O 0.5 tally_only ${TALLY} O
bound_modify zlo react both

timestep 0.01
stats 100
stats_style step time np nsreact
run 100
