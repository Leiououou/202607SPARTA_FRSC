balance_grid        rcb cell
Balance grid migrated 74 cells
  CPU time = 0.00174822 secs
  reassign/sort/migrate/ghost percent = 41.4841 0.0413565 39.6395 18.835

global		    	nrho 4.138807e+20 fnum 1.4900e+11 temp ${T}
global		    	nrho 4.138807e+20 fnum 1.4900e+11 temp 700

species		    	air.species O CO CO2 O2 C N N2 NO
mixture		    	air O O2 N N2 vstream 0 0 0

mixture             air O   frac 1
mixture             air CO  frac 0.0
mixture             air CO2 frac 0.0
mixture             air C   frac 0.0
mixture 			air O2 	frac 0.0
mixture 			air N 	frac 0
mixture 			air N2 	frac 0.0
mixture 			air NO 	frac 0.0

create_particles    air n 0
Created 99998 particles
  CPU time = 0.0031011 secs

surf_collide        1 diffuse ${T} 1
surf_collide        1 diffuse 700 1

##################################### SURF REACT ADSORB ######################################
##################################### SURF OPTION ############################################

shell           sed "s/td [0-9]*/td ${T}/g" schu_gs_1.surf > schu_gs_1_${T}.surf
shell           sed "s/td [0-9]*/td ${T}/g" schu_gs_1.surf > schu_gs_1_700.surf

surf_react        	adsorb_test_gs2 adsorb gs schu_gs_1_${T}.surf nsync 1 face ${T} 6.022e18 schu yes init_cover O tally_only yes O CO N N2 O2 NO
surf_react        	adsorb_test_gs2 adsorb gs schu_gs_1_700.surf nsync 1 face ${T} 6.022e18 schu yes init_cover O tally_only yes O CO N N2 O2 NO
surf_react        	adsorb_test_gs2 adsorb gs schu_gs_1_700.surf nsync 1 face 700 6.022e18 schu yes init_cover O tally_only yes O CO N N2 O2 NO

bound_modify        xhi collide 1 react adsorb_test_gs2

timestep            1e-6

stats		    	10
stats_style	    	step cpu np nattempt ncoll nscoll nscheck nsreact
