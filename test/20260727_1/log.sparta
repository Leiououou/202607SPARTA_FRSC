seed	    	    123456
dimension   	    2
global              gridcut 0.0 comm/sort yes

boundary	    	rs r p


create_box          -3e-3 3e-3 -3e-3 3e-3 -0.5 0.5
Created orthogonal box = (-0.003 -0.003 -0.5) to (0.003 0.003 0.5)
create_grid 	    10 10 1
WARNING: Could not acquire nearby ghost cells b/c grid partition is not clumped (../grid.cpp:473)
Created 100 child grid cells
  CPU time = 0.000681855 secs
  create/ghost percent = 55.975 44.025
balance_grid        rcb cell
Balance grid migrated 74 cells
  CPU time = 0.00119151 secs
  reassign/sort/migrate/ghost percent = 10.229 0.0639525 66.0297 23.6774

global		    	nrho 4.138807e+20 fnum 1.4900e+11 temp 1000

species		    	air.species O CO CO2 O2 C N N2 NO
mixture		    	air O O2 N N2 vstream 0 0 0

mixture             air O   frac 1
mixture             air CO  frac 0.0
mixture             air CO2 frac 0.0
mixture             air C   frac 0.0
mixture 			air O2 	frac 0.0
mixture 			air N 	frac 0
mixture 			air N2 	frac 0.0
mixture 			air NO 	frac 0.0

create_particles    air n 0
Created 99998 particles
  CPU time = 0.00342601 secs

surf_collide        1 diffuse 1000 1

##################################### SURF REACT ADSORB ######################################
##################################### SURF OPTION ############################################



surf_react        	adsorb_test_gs2 adsorb ps sample-PS_1.surf nsync 1 face 1000 6.022e18 schu yes init_cover O 1 tally_only yes O CO N N2 O2 NO

bound_modify        xhi collide 1 react adsorb_test_gs2

timestep            1e-6

compute         1 boundary all n nflux ke erot evib etot echem
fix             2 ave/time 1 1 1 c_1[*] mode vector ave running file boundary.dat

stats		    	10
stats_style	    	step cpu np nattempt ncoll nscoll nscheck nsreact
run 		    	1000
