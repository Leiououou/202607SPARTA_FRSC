################################################################################
# nsite对gamma风格计算结果的高超来流敏感性分析
# 圆柱绕流算例
# 火星大气90km工况
#rou=2.6074e-7  T=144.77  Tw=824 U=4811.0
#cal_mac_proper_PLUS.m 计算得到各组分最小值 lambda_min=5.4e-2 t_min=2e-4，nrho=3.63e+18
#目标网格尺寸=1.8e-2，dt=2e-6（百分之一最小平均碰撞时间）
################################################################################
shell           mkdir data
seed	    	    123456
dimension   	    2
global              gridcut 0.0 comm/sort yes

boundary	    	o o p


create_box          -2 2 -2 2 -0.5 0.5
create_grid 	    223 223 1
balance_grid        rcb cell

global		    	nrho 3.63e+18 fnum 3.8931e+13 vstream 4811 0 0 temp 144.74
species		    air.species N2 O2 NO N O CO2 CO C vibfile co2.species.vib
mixture		    air N2 frac 0.05
mixture		    air O2 frac 0.05
mixture		    air NO frac 0.0
mixture		    air N frac 0.3
mixture		    air O frac 0.2
mixture		    air CO2 frac 0.1
mixture		    air CO frac 0.0
mixture		    air C frac 0.3
mixture         N2 N2
mixture         O2 O2
mixture         NO NO 
mixture         N N
mixture         O O
mixture         CO2 CO2
mixture         CO CO
mixture         C C

read_surf           circle_R0.5_P10000.surf
surf_collide        1 diffuse 560 1#漫反射
surf_modify         all collide 1
react               tce air.tce
react_modify         recomb no partial_energy no #设置为no才使用总能量模型

fix                 in  emit/face air xlo xhi ylo yhi 

collide             vss air air.vss
collide_modify      vibrate discrete rotate smooth
fix                 vib vibmode

create_particles    air n 0
##################################### SURF REACT ADSORB ######################################
##################################### SURF OPTION ############################################

#surf_react        	adsorb_test_gs2 adsorb ps sample-PS_1.surf nsync 1 face 1000 6.022e18 schu yes init_cover O 1 tally_only yes O CO N N2 O2 NO
#bound_modify        xhi collide 1 react adsorb_test_gs2

surf_react          gamma gamma gamma.surf surf 560 6.022e18  O 1 C 1 N 1 
surf_modify         all react gamma
#bound_modify        xhi collide 1 react gamma

timestep            2e-6

#compute         1 boundary all n nflux ke erot evib etot echem
#fix             2 ave/time 1 1 1 c_1[*] mode vector ave one file boundary.dat



stats		    	10
stats_style	    	step cpu np nattempt ncoll nscoll nscheck nsreact
run             10
fix             bal1 balance 100 1.2 rcb time 
fix             bal2 balance 1000 1.02 rcb time 
#adapt_grid      all refine surf all 1e-3 iterate 3
#adapt_grid      all refine surf all 1e-3 iterate 3 

run             1000
adapt_grid      all refine particle 200 400 iterate 3
run             1000
adapt_grid      all refine particle 200 400 iterate 3
run             1000
adapt_grid      all refine particle 200 200 iterate 3
run             1000
adapt_grid      all refine particle 50 50 iterate 3
##################################################################################################
#统计网格物理信息
compute			1 grid all air  nrho  u v  trot
compute			2 thermal/grid all air temp press
compute         3 tvib/grid all air 
compute         4 grid all CO2 nrho 
compute         5 grid all N2 nrho


fix				1 ave/grid all 1 10000 10000 c_1[*] c_2[*] c_3[*] c_4[*] c_5[*]  ave running
dump		    1 grid all 10000 data/grid.*.dat id xc yc  f_1[*]
dump_modify		1 format float %12.5g
###################################################################################################

####################################################################################################
#统计表面信息
compute		    9 surf all all n nwt press  fx fy  px py  shx shy  etot ke erot evib echem
fix 		    2 ave/surf all 1 10000 10000 c_9[*] ave running
dump		    2 surf all 10000 data/surf.*.dat id v1x v1y  v2x v2y  f_2[*]
dump_modify		2 format float %12.5g
#####################################################################################################

run             10000
